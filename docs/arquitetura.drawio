  <diagram id="k3s-django-mysql-azure" name="Arquitetura Cluster K3s">
    <mxGraphModel dx="1420" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="760" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;Arquitetura do Cluster Kubernetes (K3s) — Django + MySQL no Microsoft Azure&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="160" y="20" width="960" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="user" value="&lt;b&gt;Usuário / Navegador&lt;/b&gt;&lt;br&gt;Acesso externo via&lt;br&gt;http://&amp;lt;IP_PUBLICO_VM2&amp;gt;:30080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e3a8a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="210" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="dockerhub" value="&lt;b&gt;Docker Hub&lt;/b&gt;&lt;br&gt;yamaguti01/django-k3s:v1&lt;br&gt;mysql:8.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="210" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="vnet" value="&lt;b&gt;Microsoft Azure — Rede Privada (VNet 172.16.0.0/16)&lt;/b&gt;" style="swimlane;startSize=32;rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=2;dashed=1;fontColor=#0369a1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="310" y="75" width="930" height="630" as="geometry"/>
        </mxCell>

        <mxCell id="vm1" value="&lt;b&gt;VM1 — Control Plane (K3s Server)&lt;/b&gt;&lt;br&gt;Sem Pods da aplicação (Taint: NoSchedule)" style="swimlane;startSize=44;rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#92400e;fontSize=12;" vertex="1" parent="vnet">
          <mxGeometry x="30" y="55" width="270" height="250" as="geometry"/>
        </mxCell>

        <mxCell id="apiserver" value="&lt;b&gt;K3s Server / API Server&lt;/b&gt;&lt;br&gt;Porta 6443 (TCP)&lt;br&gt;Scheduler • Controller • etcd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;fontColor=#78350f;fontSize=11;" vertex="1" parent="vm1">
          <mxGeometry x="25" y="65" width="220" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="kubectl" value="&lt;b&gt;Gerenciamento (kubectl)&lt;/b&gt;&lt;br&gt;apply • scale (1→3→1)&lt;br&gt;get nodes,pods,services -o wide" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;fontColor=#78350f;fontSize=11;" vertex="1" parent="vm1">
          <mxGeometry x="25" y="160" width="220" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="vm2" value="&lt;b&gt;VM2 — Worker Node (K3s Agent)&lt;/b&gt;&lt;br&gt;Execução exclusiva dos Pods Django e MySQL" style="swimlane;startSize=44;rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4f46e5;strokeWidth=2;fontColor=#312e81;fontSize=12;" vertex="1" parent="vnet">
          <mxGeometry x="350" y="55" width="550" height="545" as="geometry"/>
        </mxCell>

        <mxCell id="django_svc" value="&lt;b&gt;Service: django-service&lt;/b&gt;&lt;br&gt;Tipo: NodePort&lt;br&gt;Porta externa: 30080 → 8000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e3a8a;fontSize=11;" vertex="1" parent="vm2">
          <mxGeometry x="30" y="65" width="220" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="django_deploy" value="&lt;b&gt;Deployment: django&lt;/b&gt;&lt;br&gt;Pods Django + Gunicorn (:8000)&lt;br&gt;Réplicas: 1 (escalável para 3)&lt;br&gt;DB_HOST=mysql-service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f46e5;strokeWidth=2;fontColor=#1e1b4b;fontSize=11;" vertex="1" parent="vm2">
          <mxGeometry x="290" y="60" width="230" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="mysql_svc" value="&lt;b&gt;Service: mysql-service&lt;/b&gt;&lt;br&gt;Tipo: ClusterIP (interno)&lt;br&gt;Porta: 3306 (TCP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4338ca;strokeWidth=2;fontColor=#312e81;fontSize=11;" vertex="1" parent="vm2">
          <mxGeometry x="290" y="195" width="230" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="mysql_deploy" value="&lt;b&gt;Deployment: mysql&lt;/b&gt;&lt;br&gt;Pod MySQL 8.0 (strategy: Recreate)&lt;br&gt;Montagem: /var/lib/mysql" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;fontColor=#134e4a;fontSize=11;" vertex="1" parent="vm2">
          <mxGeometry x="290" y="315" width="230" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="secret" value="&lt;b&gt;Secret: mysql-secret&lt;/b&gt;&lt;br&gt;Credenciais do MySQL&lt;br&gt;e DJANGO_SECRET_KEY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#db2777;fontColor=#831843;fontSize=11;" vertex="1" parent="vm2">
          <mxGeometry x="30" y="210" width="210" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="pvc" value="&lt;b&gt;PVC: mysql-pvc&lt;/b&gt;&lt;br&gt;ReadWriteOnce • 2Gi&lt;br&gt;storageClassName: manual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0d9488;fontColor=#134e4a;fontSize=11;" vertex="1" parent="vm2">
          <mxGeometry x="30" y="435" width="215" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="pv" value="&lt;b&gt;PV: mysql-pv&lt;/b&gt;&lt;br&gt;hostPath: /mnt/data/mysql&lt;br&gt;ReclaimPolicy: Retain" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#99f6e4;strokeColor=#0f766e;strokeWidth=2;fontColor=#134e4a;fontSize=11;" vertex="1" parent="vm2">
          <mxGeometry x="295" y="430" width="220" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="e_user_svc" value="HTTP :30080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e40af;fontSize=11;" edge="1" source="user" target="django_svc" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_docker_vm2" value="Image Pull" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#16a34a;strokeWidth=2;fontColor=#166534;fontSize=11;" edge="1" source="dockerhub" target="vm2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_vm1_vm2" value="Rede Privada&lt;br&gt;K3s :6443 / Flannel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=2;fontColor=#92400e;fontSize=11;" edge="1" source="apiserver" target="vm2" parent="vnet">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_svc_django" value=":8000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e40af;fontSize=11;" edge="1" source="django_svc" target="django_deploy" parent="vm2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_django_mysqlsvc" value="TCP :3306" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4338ca;strokeWidth=2;fontColor=#312e81;fontSize=11;" edge="1" source="django_deploy" target="mysql_svc" parent="vm2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_mysqlsvc_pod" value=":3306" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f766e;strokeWidth=2;fontColor=#134e4a;fontSize=11;" edge="1" source="mysql_svc" target="mysql_deploy" parent="vm2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_mysql_pvc" value="Mount" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0d9488;strokeWidth=2;fontColor=#134e4a;fontSize=11;" edge="1" source="mysql_deploy" target="pvc" parent="vm2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_pvc_pv" value="Bind" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f766e;strokeWidth=2;fontColor=#134e4a;fontSize=11;" edge="1" source="pvc" target="pv" parent="vm2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_secret_django" value="env" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#db2777;fontColor=#9d174d;fontSize=10;" edge="1" source="secret" target="django_deploy" parent="vm2">
